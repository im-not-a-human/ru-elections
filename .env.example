# Ключи api.duma.gov.ru — получить на https://api.duma.gov.ru/registration
# DUMA_APP_KEY — «ключ приложения», идёт в URL path: /api/{DUMA_APP_KEY}/...
DUMA_APP_KEY=

# DUMA_USER_KEY — «личный ключ», идёт как query-параметр ?app_token={DUMA_USER_KEY}
DUMA_USER_KEY=

# Опционально: симфони-сессионный cookie с api.duma.gov.ru.
# Если фронт сайта пускает запрос без него — оставь пустым; некоторые конфигурации требуют.
# Формат: "symfony=xxxxxxxx" (с префиксом, как из браузера)
DUMA_COOKIE=

# Опционально: SOCKS5/HTTPS прокси для обхода геоблока. Если пусто — наследуется HTTP_PROXY/HTTPS_PROXY.
# Формат: socks5h://host:port  или  http://user:pass@host:port
DUMA_PROXY=
